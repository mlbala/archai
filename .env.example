ARCHAI_OUTPUT_DIR=output
ARCHAI_ARCHITECT_PROVIDER=openai
ARCHAI_ARCHITECT_MODEL=gpt-6-sol
# Providers: openai (default), anthropic, gemini, deepseek. Switch with `archai model use`.
ARCHAI_OPENAI_API_KEY=
ARCHAI_ANTHROPIC_API_KEY=
ARCHAI_GEMINI_API_KEY=
ARCHAI_DEEPSEEK_API_KEY=
# ARCHAI_DEEPSEEK_BASE_URL=https://api.deepseek.com
# ARCHAI_ANTHROPIC_EFFORT=high
# ARCHAI_ANTHROPIC_FALLBACKS=true
# Optional: give specific architect roles a different model (multi-model design).
# Roles: requirements, planner, cloud, api, security, verifier
# ARCHAI_ROLE_MODELS=verifier=anthropic:claude-sonnet-5-5,cloud=deepseek:deepseek-v4-pro
# Optional bounds for one run (defaults shown).
# ARCHAI_MAX_GENERATION_CALLS=32
# ARCHAI_MAX_GENERATION_TOKENS=800000
# ARCHAI_MAX_REPAIR_PASSES=4
# ARCHAI_REQUEST_TIMEOUT_SECONDS=300
