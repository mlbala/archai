# Python bytecode and environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Python build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test, type-checker, formatter and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local secrets and private configuration; sample files remain trackable
.env
.env.*
!.env.example
!.env.*.example
*.key
*.pem
*.p12
*.pfx
archai.local.*

# Generated project data and reports; curated examples belong in examples/
/output/
/outputs/
/work/
/logs/
*.log
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Infrastructure state, local caches and real variable values
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
crash.log
crash.*.log
# Keep .terraform.lock.hcl tracked for reproducible provider selection.

# Optional diagram renderer dependencies
node_modules/
# Keep package lockfiles and uv.lock tracked.

# Operating system and editor temporary files
.DS_Store
._*
Thumbs.db
*.swp
*.swo
*~
